# Supabase project URL and anon (public) key, from Project Settings > API.
# Required for the catalog, admin login and order backend to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Defaults to https://three16craft.com; set only for a different
# domain (e.g. a preview deployment).
NEXT_PUBLIC_SITE_URL=

# Optional, leave empty: images are served from public/three16craft. Only
# needed if images later move to a separate image host (e.g. Cloudflare R2).
NEXT_PUBLIC_ASSET_BASE_URL=

# WhatsApp numbers and the business location are set in the admin at
# /316nas/settings, not here.
