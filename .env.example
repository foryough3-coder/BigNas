# Supabase project URL and anon (public) key, from Project Settings > API.
# Required for the catalog, admin login and order backend to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Leave empty to use the bundled images in public/three16craft.
# After uploading to R2, enter your HTTPS asset domain (no trailing slash).
NEXT_PUBLIC_ASSET_BASE_URL=

# Public website origin used in enquiry product links (optional locally).
NEXT_PUBLIC_SITE_URL=

# WhatsApp numbers and the business location are set in the admin at
# /316nas/settings, not here.
